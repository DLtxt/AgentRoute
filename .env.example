# Copy to .env and fill in. .env is gitignored and never committed.

# --- Tier behaviour ---------------------------------------------------------
# true  -> canned responses, no network, no credentials. Always use this for
#          load tests, or you will pay real money to benchmark yourself.
# false -> live tiers (Ring 1+); requires ANTHROPIC_API_KEY.
MOCK_TIERS=true

# Only needed when MOCK_TIERS=false.
ANTHROPIC_API_KEY=

# --- Services (portability rule 1: never hardcode these) --------------------
REDIS_URL=redis://redis:6379/0
OLLAMA_URL=http://host.docker.internal:11434

# --- Cache ------------------------------------------------------------------
CACHE_TTL_SECONDS=3600
CACHE_SCHEMA_VERSION=v1

# --- Classifier: rules | logreg | xgb ---------------------------------------
CLASSIFIER=rules

LOG_LEVEL=INFO
