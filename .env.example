# Copy to .env and fill in. .env is gitignored and never committed.

# --- Tier behaviour ---------------------------------------------------------
# true  -> canned responses, no network, no credentials. Always use this for
#          load tests, or you will pay real money to benchmark yourself.
# false -> live tiers (Ring 1+); requires ANTHROPIC_API_KEY.
MOCK_TIERS=true

# Only needed when MOCK_TIERS=false.
ANTHROPIC_API_KEY=

# --- Services (portability rule 1: never hardcode these) --------------------
REDIS_URL=redis://redis:6379/0

# Host-run Ollama by default. On macOS a containerized Ollama gets no Metal
# access and runs on CPU; use http://ollama:11434 with the with-ollama profile
# on Linux or in CI.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

# --- Paid tiers -------------------------------------------------------------
# A cap, not a target — you are billed for what is generated.
MAX_TOKENS=1024
# Sonnet 5 runs adaptive thinking by default. "disabled" trades quality for
# lower cost and latency.
SONNET_THINKING=adaptive

# --- Cache ------------------------------------------------------------------
CACHE_TTL_SECONDS=3600
CACHE_SCHEMA_VERSION=v1

# --- Classifier: rules | logreg | xgb ---------------------------------------
CLASSIFIER=rules

LOG_LEVEL=INFO
